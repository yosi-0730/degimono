    "type": "template",
    "name": "入出庫管理画面",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>在庫管理システム</title>\n<style>\n  :root { --yellow:#ffff00; --pink:#ffc9b8; --blue:#0a97e8; --green:#4cc552; --orange:#f58a1f; --red:#e8400c; }\n  * { box-sizing: border-box; }\n  body { margin:0; padding:16px; background:#f4f4f4; font-family:\"Meiryo\",\"Hiragino Kaku Gothic ProN\",sans-serif; color:#111; }\n  .frame { background:var(--yellow); border:3px solid #000; padding:16px 20px 20px; max-width:1100px; margin:0 auto; }\n  .head { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; }\n  .head h1 { margin:0; font-size:30px; }\n  .head .btns { display:flex; gap:8px; }\n  button { font:inherit; cursor:pointer; }\n  .btn { background:#fff; border:1px solid #888; padding:8px 14px; font-weight:bold; }\n  .btn.blue { background:var(--blue); color:#fff; border-color:var(--blue); }\n  .btn.green { background:var(--green); border-color:#2d9c33; color:#000; font-size:18px; padding:10px 14px; }\n  .btn.red { background:var(--red); border-color:#b02e08; color:#fff; font-size:20px; padding:12px; width:100%; }\n  .btn.gray { background:#ddd; }\n  .btn:disabled { opacity:.5; cursor:not-allowed; }\n  .grid { display:grid; grid-template-columns: 1fr 1fr; gap:16px; }\n  .card { background:#fff; border:1px solid #bbb; padding:12px; }\n  .card.cream { background:#fffbd0; }\n  .card.pink { background:var(--pink); }\n  .card h2 { margin:0 0 8px; font-size:20px; }\n  .row { display:flex; gap:8px; }\n  input, select { font:inherit; padding:8px; border:1px solid #999; background:#fff; width:100%; }\n  label { display:block; margin:10px 0 4px; font-weight:bold; }\n  .chips { margin-top:8px; display:flex; flex-wrap:wrap; gap:6px; }\n  .chip { background:#fff; border:1px solid #999; padding:4px 10px; border-radius:14px; font-size:13px; }\n  .chip.sel { background:#222; color:#fff; }\n  /* 工場配置図 */\n  .map { display:grid; gap:6px; grid-template-columns: 1.2fr 1fr 1fr 1.2fr; grid-template-rows: repeat(4, 54px);\n         grid-template-areas: \"proc A B asm\" \"proc C D asm\" \"proc E F asm\" \"proc shelf shelf asm\";\n         border:6px solid #555; padding:8px; background:#fff; }\n  .map div { background:#ddd; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:18px; }\n  .map .proc { grid-area:proc; font-size:15px; } .map .asm { grid-area:asm; font-size:15px; }\n  .map .shelf { grid-area:shelf; font-size:14px; }\n  .map .hit { background:var(--red); color:#fff; outline:3px solid #000; }\n  dl.info { margin:0; }\n  dl.info div { display:flex; padding:3px 0; }\n  dl.info dt { width:90px; font-weight:bold; } dl.info dd { margin:0; }\n  .banner { text-align:center; color:#fff; font-weight:bold; font-size:20px; padding:14px; margin-top:12px; border:1px solid #b02e08; }\n  .banner.wait { background:var(--orange); }\n  .banner.need { background:var(--red); }\n  table { width:100%; border-collapse:collapse; background:#fff; }\n  th, td { border:1px solid #ccc; padding:8px; text-align:center; }\n  th { background:#eee; }\n  tr.row-sel td { background:var(--pink); }\n  tbody tr.clickable { cursor:pointer; }\n  .tag { display:inline-block; padding:3px 10px; font-weight:bold; border:1px solid; }\n  .tag.need { background:var(--orange); border-color:#c06c10; } .tag.ok { background:#6fdc74; border-color:#3a9c40; }\n  .tabs { display:flex; gap:12px; margin-bottom:10px; }\n  .tab { flex:1; max-width:250px; text-align:center; padding:12px; font-size:20px; font-weight:bold; background:#fff; border:1px solid #888; }\n  .tab.on { background:var(--blue); color:#fff; border-color:var(--blue); }\n  .legend { font-size:13px; margin:6px 0 8px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }\n  .legend .box { width:28px; height:20px; background:var(--pink); border:1px solid #aaa; }\n  .recv-box { background:#d9f5d6; border:1px solid #2d9c33; padding:8px; font-weight:bold; }\n  .toast { position:fixed; left:50%; bottom:24px; transform:translateX(-50%); background:#222; color:#fff; padding:12px 22px; border-radius:6px; z-index:9; }\n  .toast.err { background:#b00020; }\n  .muted { color:#555; font-size:13px; }\n  .orderlayout { display:grid; grid-template-columns: 1.1fr 1fr; gap:16px; }\n  @media (max-width: 820px) { .grid, .orderlayout { grid-template-columns: 1fr; } }\n</style>\n</head>\n<body>\n<div class=\"frame\" id=\"app\"></div>\n<div class=\"toast\" id=\"toast\" style=\"display:none\"></div>\n\n<script>\nconst S = {\n  view: 'main',              // main | orders | register\n  locations: [],             // 保管場所の選択肢 (/api/locations)\n  reg: { id:'', name:'', location:'', stock:'0', reorder:'0', departments:'', dept:'', emp:'' },  // 部品登録フォーム\n  tab: 'unordered',          // unordered | waiting\n  part: null,                // 入出庫管理画面で表示中の部品\n  results: [],               // 検索結果\n  query: '',\n  selectedPart: null,        // 発注管理: 選択中の部品(未発注)\n  receivingOrder: null,      // 入庫登録中の発注\n  receiver: null,            // 入庫担当者 {id,name} ― 入荷登録を終了するまで保持\n  orderer: { dept: '', emp: '' },\n  recvPick: { dept: '', emp: '' },\n  deptList: [], employees: []\n};\ntry { const r = sessionStorage.getItem('receiver'); if (r) S.receiver = JSON.parse(r); } catch (e) {}\n\nconst $app = document.getElementById('app');\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst today = () => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };\n\nasync function api(path, opts) {\n  const res = await fetch(path, opts);\n  let body = null; try { body = await res.json(); } catch (e) {}\n  if (!res.ok) throw new Error((body && body.message) || ('通信エラー ' + res.status));\n  return body;\n}\nconst post = (path, data) => api(path, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });\n\nlet toastTimer;\nfunction toast(msg, isErr) {\n  const t = document.getElementById('toast');\n  t.textContent = msg; t.className = 'toast' + (isErr ? ' err' : ''); t.style.display = 'block';\n  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.style.display = 'none', 3500);\n}\nfunction setReceiver(r) {\n  S.receiver = r;\n  try { r ? sessionStorage.setItem('receiver', JSON.stringify(r)) : sessionStorage.removeItem('receiver'); } catch (e) {}\n}\n\n/* ---------- 部署→従業員プルダウン ---------- */\nfunction empPicker(id, st) {\n  const emps = S.employees.filter(e => e.department === st.dept);\n  return `\n    <select id=\"${id}-dept\"><option value=\"\">部署を選択</option>\n      ${S.deptList.map(d => `<option ${d === st.dept ? 'selected' : ''}>${esc(d)}</option>`).join('')}</select>\n    <select id=\"${id}-emp\" style=\"margin-top:6px\" ${st.dept ? '' : 'disabled'}><option value=\"\">従業員を選択</option>\n      ${emps.map(e => `<option value=\"${esc(e.id)}\" ${e.id === st.emp ? 'selected' : ''}>${esc(e.name)}</option>`).join('')}</select>`;\n}\nfunction bindPicker(id, st) {\n  const d = document.getElementById(id + '-dept'), e = document.getElementById(id + '-emp');\n  d.onchange = () => { st.dept = d.value; st.emp = ''; render(false); };\n  e.onchange = () => { st.emp = e.value; };\n}\n\n/* ---------- 入出庫管理画面 ---------- */\nfunction mapHtml(loc) {\n  const cell = k => `<div class=\"${loc === k ? 'hit' : ''}\" style=\"grid-area:${k}\">${k}</div>`;\n  return `<div class=\"map\">\n    <div class=\"proc\">加工エリア</div>${['A','B','C','D','E','F'].map(cell).join('')}\n    <div class=\"shelf ${loc === '部品棚' ? 'hit' : ''}\">部品棚</div><div class=\"asm\">組立エリア</div></div>`;\n}\nfunction infoHtml(p) {\n  const w = p.waiting_order;\n  const status = w ? `発注済・入荷待ち（入荷予定 ${esc(w.expected_date)}）` : '未発注';\n  const o = S.receivingOrder;\n  return `<dl class=\"info\">\n    <div><dt>品名</dt><dd>${esc(p.name)}</dd></div>\n    <div><dt>品番</dt><dd>${esc(p.id)}</dd></div>\n    <div><dt>保管場所</dt><dd>${esc(p.location)}</dd></div>\n    <div><dt>在庫数</dt><dd>${p.stock} 個　　<b>発注点：</b>${p.reorder_point} 個</dd></div>\n    <div><dt>使用部署</dt><dd>${esc(p.departments)}</dd></div>\n    ${o ? `<div><dt>発注数量</dt><dd>${o.quantity} 個</dd></div>` : ''}\n    <div><dt>発注状況</dt><dd>${status}</dd></div></dl>`;\n}\nfunction receivePanel() {\n  const o = S.receivingOrder;\n  const who = S.receiver\n    ? `<div class=\"row\" style=\"align-items:center\"><div class=\"recv-box\" style=\"flex:1\">入庫担当者：${esc(S.receiver.name)}</div>\n         <button class=\"btn\" id=\"btn-endrecv\">入荷登録を終了</button></div>`\n    : `<label>入庫担当者（初回のみ設定）</label>${empPicker('recv', S.recvPick)}\n       <button class=\"btn blue\" id=\"btn-setrecv\" style=\"margin-top:8px\">担当者を設定</button>`;\n  return `<div class=\"card\" style=\"margin-top:12px\"><h2>入庫登録</h2>${who}\n    <label>実入荷日</label><input type=\"date\" id=\"recv-date\" value=\"${today()}\">\n    <label>入荷数量</label><input type=\"number\" min=\"1\" id=\"recv-qty\" value=\"${o.quantity}\">\n    <div class=\"row\" style=\"margin-top:12px\">\n      <button class=\"btn green\" id=\"btn-confirm\" style=\"flex:2\" ${S.receiver ? '' : 'disabled'}>入庫登録を確定</button>\n      <button class=\"btn gray\" id=\"btn-back\" style=\"flex:1\">一覧へ戻る</button></div></div>`;\n}\nfunction mainView() {\n  const p = S.part;\n  let right = `<div class=\"card pink\"><h2>部品情報</h2><p class=\"muted\">部品を検索してください。</p></div>`;\n  if (p) {\n    let banner = '';\n    if (p.below_point && !S.receivingOrder) {\n      banner = p.waiting_order\n        ? `<div class=\"banner wait\">在庫が発注点以下です<br>発注済・入荷待ち</div>`\n        : `<div style=\"margin-top:12px\"><div class=\"banner need\" style=\"margin:0 0 8px\">在庫が発注点以下です（未発注）</div>\n             <button class=\"btn red\" id=\"btn-order\">発注登録</button></div>`;\n    }\n    right = `<div class=\"card pink\"><h2>部品情報</h2>${infoHtml(p)}</div>\n             ${S.receivingOrder ? receivePanel() : banner}`;\n  }\n  const loc = p ? p.location : '';\n  const chips = S.results.map(r => `<button class=\"chip ${p && p.id === r.id ? 'sel' : ''}\" data-id=\"${esc(r.id)}\">${esc(r.id)} ${esc(r.name)}</button>`).join('');\n  return `\n  <div class=\"head\"><h1>入出庫管理</h1>\n    <div class=\"btns\"><a class=\"btn\" href=\"/download/history.csv\" style=\"text-decoration:none;color:#000\">入出庫履歴.csv出力</a>\n      <button class=\"btn\" id=\"btn-open-reg\">部品登録</button>\n      <button class=\"btn\" id=\"btn-open-orders\">発注管理を開く</button></div></div>\n  <div class=\"grid\">\n    <div>\n      <div class=\"card cream\"><h2>部品検索</h2>\n        <div class=\"row\"><input id=\"q\" placeholder=\"品名・品番を入力\" value=\"${esc(S.query)}\"><button class=\"btn blue\" id=\"btn-search\" style=\"width:100px\">検索</button></div>\n        <div class=\"chips\">${chips || '<span class=\"muted\">該当なし</span>'}</div></div>\n      <div class=\"card\" style=\"margin-top:12px\"><h2>工場配置図</h2>${mapHtml(loc)}\n        <p class=\"muted\">工場配置図は表示例です。実際の写真・配置図を固定表示します。</p></div>\n    </div>\n    <div>${right}</div>\n  </div>`;\n}\nfunction bindMain() {\n  const q = document.getElementById('q');\n  const go = () => search(q.value);\n  document.getElementById('btn-search').onclick = go;\n  q.onkeydown = e => { if (e.key === 'Enter') go(); };\n  document.getElementById('btn-open-orders').onclick = () => openOrders('unordered');\n  document.getElementById('btn-open-reg').onclick = () => { S.view = 'register'; render(false); };\n  document.querySelectorAll('.chip[data-id]').forEach(b => b.onclick = async () => {\n    S.part = await api('/api/parts/' + encodeURIComponent(b.dataset.id)); S.receivingOrder = null; render(false);\n  });\n  const bo = document.getElementById('btn-order');\n  if (bo) bo.onclick = () => openOrders('unordered', S.part.id);\n  if (S.receivingOrder) bindReceive();\n}\nfunction bindReceive() {\n  if (S.receiver) {\n    document.getElementById('btn-endrecv').onclick = () => { setReceiver(null); S.receivingOrder = null; openOrders('waiting'); toast('入荷登録を終了しました'); };\n  } else {\n    bindPicker('recv', S.recvPick);\n    document.getElementById('btn-setrecv').onclick = () => {\n      const e = S.employees.find(x => x.id === S.recvPick.emp);\n      if (!e) return toast('入庫担当者を選択してください', true);\n      setReceiver({ id: e.id, name: e.name }); render(false);\n    };\n  }\n  document.getElementById('btn-back').onclick = () => { S.receivingOrder = null; openOrders('waiting'); };\n  document.getElementById('btn-confirm').onclick = async () => {\n    try {\n      const r = await post('/api/checkin', {\n        order_id: S.receivingOrder.id, employee_id: S.receiver.id,\n        received_date: document.getElementById('recv-date').value,\n        quantity: Number(document.getElementById('recv-qty').value) });\n      toast(r.message + '（在庫 ' + r.stock + '）');\n      S.receivingOrder = null; S.part = null; await openOrders('waiting');\n    } catch (e) { toast(e.message, true); }\n  };\n}\nasync function search(q) {\n  S.query = q;\n  S.results = await api('/api/parts?q=' + encodeURIComponent(q));\n  S.receivingOrder = null;\n  S.part = S.results.length === 1 ? S.results[0] : null;\n  render(false);\n}\n\n/* ---------- 発注管理一覧 ---------- */\nasync function openOrders(tab, partId) {\n  S.view = 'orders'; S.tab = tab;\n  S.selectedPart = null;\n  if (tab === 'unordered') {\n    S.unordered = await api('/api/orders/unordered');\n    if (partId) S.selectedPart = S.unordered.find(p => p.id === partId) || null;\n  } else {\n    S.waiting = await api('/api/orders/waiting');\n  }\n  render(false);\n}\nfunction ordersView() {\n  const tabs = `<div class=\"tabs\">\n    <button class=\"tab ${S.tab === 'unordered' ? 'on' : ''}\" data-tab=\"unordered\">未発注</button>\n    <button class=\"tab ${S.tab === 'waiting' ? 'on' : ''}\" data-tab=\"waiting\">入荷待ち</button></div>`;\n  let body = '';\n  if (S.tab === 'unordered') {\n    const sp = S.selectedPart;\n    const rows = (S.unordered || []).map(p => `\n      <tr class=\"clickable ${sp && sp.id === p.id ? 'row-sel' : ''}\" data-id=\"${esc(p.id)}\">\n        <td>${esc(p.id)}</td><td>${esc(p.name)}</td><td>${p.stock}</td><td>${p.reorder_point}</td>\n        <td><span class=\"tag ${p.below_point ? 'need' : 'ok'}\">${p.below_point ? '要発注' : '発注不要'}</span></td></tr>`).join('');\n    const form = sp ? `\n      <div class=\"card\" style=\"background:var(--pink)\"><h2>発注結果の登録</h2>\n        <div class=\"card cream\" style=\"font-size:18px\">${esc(sp.id)}　${esc(sp.name)}</div>\n        <label>発注担当者</label>${empPicker('ord', S.orderer)}\n        <label>発注数量</label><input type=\"number\" min=\"1\" id=\"ord-qty\" placeholder=\"例: 10\">\n        <label>発注日</label><input type=\"date\" id=\"ord-date\" value=\"${today()}\">\n        <label>入荷予定日</label><input type=\"date\" id=\"ord-exp\">\n        <button class=\"btn green\" id=\"btn-save\" style=\"width:100%;margin-top:14px\">発注結果を保存</button>\n        <p class=\"muted\" style=\"text-align:center\">保存すると「入荷待ち」へ移動</p></div>`\n      : `<div class=\"card\" style=\"background:var(--pink)\"><h2>発注結果の登録</h2><p class=\"muted\">左の一覧から部品を選択してください。</p></div>`;\n    body = `<div class=\"orderlayout\"><div>\n        <div class=\"legend\"><span class=\"box\"></span>選択中 <span class=\"tag need\">要発注</span> <span class=\"tag ok\">発注不要</span>\n          <span>要発注：在庫 ≦ 発注点 ／ 発注不要：在庫 ＞ 発注点</span></div>\n        <table><thead><tr><th>品番</th><th>品名</th><th>在庫</th><th>発注点</th><th>状態</th></tr></thead><tbody>${rows}</tbody></table></div>\n        <div>${form}</div></div>`;\n  } else {\n    const rows = (S.waiting || []).map(o => `\n      <tr><td>${esc(o.part_id)}</td><td>${esc(o.part_name)}</td><td>${o.quantity}</td><td>${esc(o.orderer_name)}</td>\n        <td>${esc(o.ordered_date)}</td><td>${esc(o.expected_date)}</td>\n        <td><button class=\"btn green\" style=\"font-size:15px;padding:6px 12px\" data-oid=\"${o.id}\">入庫登録</button></td></tr>`).join('');\n    const who = S.receiver ? `<p class=\"recv-box\" style=\"display:inline-block\">入庫担当者：${esc(S.receiver.name)}\n        <button class=\"btn\" id=\"btn-endrecv2\" style=\"margin-left:8px;padding:3px 10px\">入荷登録を終了</button></p>` : '';\n    body = `${who}<table><thead><tr><th>品番</th><th>品名</th><th>発注数量</th><th>発注担当者</th><th>発注日</th><th>入荷予定日</th><th>操作</th></tr></thead>\n      <tbody>${rows || '<tr><td colspan=\"7\" class=\"muted\">入荷待ちの発注はありません</td></tr>'}</tbody></table>`;\n  }\n  return `<div class=\"head\"><h1>発注管理一覧</h1>\n    <button class=\"btn\" id=\"btn-back-main\">入出庫管理画面へ戻る</button></div>${tabs}${body}`;\n}\nfunction bindOrders() {\n  document.getElementById('btn-back-main').onclick = async () => {\n    try { if (S.part) S.part = await api('/api/parts/' + encodeURIComponent(S.part.id)); } catch (e) {}\n    try { S.results = await api('/api/parts?q=' + encodeURIComponent(S.query)); } catch (e) {}\n    S.view = 'main'; render(false);\n  };\n  document.querySelectorAll('.tab').forEach(b => b.onclick = () => openOrders(b.dataset.tab));\n  if (S.tab === 'unordered') {\n    document.querySelectorAll('tr[data-id]').forEach(tr => tr.onclick = () => {\n      S.selectedPart = S.unordered.find(p => p.id === tr.dataset.id); render(false);\n    });\n    if (S.selectedPart) {\n      bindPicker('ord', S.orderer);\n      document.getElementById('btn-save').onclick = async () => {\n        try {\n          const r = await post('/api/orders', {\n            part_id: S.selectedPart.id, employee_id: S.orderer.emp,\n            quantity: Number(document.getElementById('ord-qty').value),\n            ordered_date: document.getElementById('ord-date').value,\n            expected_date: document.getElementById('ord-exp').value });\n          toast(r.message); await openOrders('waiting');\n        } catch (e) { toast(e.message, true); }\n      };\n    }\n  } else {\n    document.querySelectorAll('button[data-oid]').forEach(b => b.onclick = async () => {\n      const o = S.waiting.find(x => String(x.id) === b.dataset.oid);\n      S.part = await api('/api/parts/' + encodeURIComponent(o.part_id));\n      S.receivingOrder = o; S.results = [S.part]; S.query = o.part_id;\n      S.view = 'main'; render(false);\n    });\n    const e2 = document.getElementById('btn-endrecv2');\n    if (e2) e2.onclick = () => { setReceiver(null); toast('入荷登録を終了しました'); render(false); };\n  }\n}\n\n/* ---------- 部品登録 ---------- */\nfunction registerView() {\n  const r = S.reg;\n  const field = (key, label, attrs) =>\n    `<label>${label}</label><input id=\"reg-${key}\" value=\"${esc(r[key])}\" ${attrs || ''}>`;\n  return `\n  <div class=\"head\"><h1>部品登録</h1>\n    <button class=\"btn\" id=\"btn-back-main\">入出庫管理画面へ戻る</button></div>\n  <div class=\"grid\">\n    <div class=\"card cream\"><h2>新しい部品の情報</h2>\n      ${field('id', '品番（必須）', 'maxlength=\"40\" placeholder=\"例: AB-1234\" autocomplete=\"off\"')}\n      ${field('name', '品名（必須）', 'placeholder=\"例: 近接センサー\"')}\n      <label>保管場所（必須）</label>\n      <select id=\"reg-location\"><option value=\"\">選択してください</option>\n        ${S.locations.map(l => `<option ${l === r.location ? 'selected' : ''}>${esc(l)}</option>`).join('')}</select>\n      <div class=\"row\">\n        <div style=\"flex:1\">${field('stock', '初期在庫', 'type=\"number\" min=\"0\" step=\"1\"')}</div>\n        <div style=\"flex:1\">${field('reorder', '発注点', 'type=\"number\" min=\"0\" step=\"1\"')}</div></div>\n      ${field('departments', '使用部署（任意）', 'placeholder=\"例: 製造部、設備保全課\"')}\n      <label>登録担当者（必須）</label>${empPicker('reg', r)}\n      <div class=\"row\" style=\"margin-top:14px\">\n        <button class=\"btn green\" id=\"btn-reg\" style=\"flex:2\">登録する</button>\n        <button class=\"btn blue\" id=\"btn-reg-more\" style=\"flex:2\">登録して続けて入力</button></div>\n      <p class=\"muted\">品番は重複できません。空白と / \\\\ ? # % は使えません。</p></div>\n    <div class=\"card\"><h2>保管場所（工場配置図）</h2>${mapHtml(r.location)}\n      <p class=\"muted\">選んだ保管場所が赤く表示されます。</p></div>\n  </div>`;\n}\nfunction bindRegister() {\n  const r = S.reg;\n  // 入力途中の値を保持（担当者プルダウン変更などで再描画しても消えないように）\n  [['id','id'],['name','name'],['stock','stock'],['reorder','reorder'],['departments','departments']].forEach(([k, id]) => {\n    document.getElementById('reg-' + id).oninput = e => { r[k] = e.target.value; };\n  });\n  document.getElementById('reg-location').onchange = e => { r.location = e.target.value; render(false); };\n  bindPicker('reg', r);\n  document.getElementById('btn-back-main').onclick = () => { S.view = 'main'; render(false); };\n\n  const submit = async more => {\n    try {\n      const res = await post('/api/parts', {\n        part_id: r.id, name: r.name, location: r.location,\n        stock: r.stock === '' ? 0 : Number(r.stock), reorder_point: r.reorder === '' ? 0 : Number(r.reorder),\n        departments: r.departments, employee_id: r.emp });\n      toast(res.message);\n      // 担当者は保持し、部品の入力項目だけ初期化\n      Object.assign(r, { id:'', name:'', location:'', stock:'0', reorder:'0', departments:'' });\n      if (more) { render(false); return; }\n      S.query = res.part.id;\n      S.results = await api('/api/parts?q=' + encodeURIComponent(res.part.id));\n      S.part = res.part; S.receivingOrder = null; S.view = 'main'; render(false);\n    } catch (e) { toast(e.message, true); }\n  };\n  document.getElementById('btn-reg').onclick = () => submit(false);\n  document.getElementById('btn-reg-more').onclick = () => submit(true);\n}\n\nfunction render() {\n  $app.innerHTML = S.view === 'main' ? mainView() : S.view === 'register' ? registerView() : ordersView();\n  S.view === 'main' ? bindMain() : S.view === 'register' ? bindRegister() : bindOrders();\n}\n\n(async function init() {\n  try {\n    const e = await api('/api/employees');\n    S.deptList = e.departments; S.employees = e.employees;\n    S.results = await api('/api/parts?q=');\n    S.locations = await api('/api/locations');\n  } catch (err) { toast(err.message, true); }\n  render();\n})();\n</script>\n</body>\n</html>\n",
